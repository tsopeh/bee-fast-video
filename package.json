{
  "name": "bee-fast-video",
  "version": "2.0.0",
  "description": "Bee fast video 🐝 - Speed up or slow down videos, seek, loop, volume, fullscreen, resize and Picture-in-picture on any website.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsopeh/bee-fast-video.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
